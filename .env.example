# Local Docker PostgreSQL. Replace with a Neon pooled PostgreSQL URL for a hosted database.
DATABASE_URL=postgresql://survey:survey_local_only@localhost:5432/iit_survey

# Generate three independent values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL
IP_HASH_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64URL
SESSION_SECRET=REPLACE_WITH_ANOTHER_32_BYTE_BASE64URL

# Choose your own long private passcode. Never commit .env.local.
SURVEY_PASSCODE=REPLACE_WITH_A_LONG_PRIVATE_PASSCODE
